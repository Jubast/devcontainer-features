{
  "id": "yq",
  "version": "1.0.0",
  "name": "yq",
  "description": "Installs mikefarah/yq v4 from GitHub releases, verified against the published checksums.",
  "documentationURL": "https://github.com/Jubast/devcontainer-features/tree/main/src/yq",
  "licenseURL": "https://github.com/Jubast/devcontainer-features/blob/main/LICENSE",
  "keywords": [
    "yaml",
    "json",
    "cli",
    "yq"
  ],
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "proposals": [
        "latest"
      ],
      "description": "Version to install (e.g. 4.54.1), or 'latest'."
    }
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils"
  ]
}
