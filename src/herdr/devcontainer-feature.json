{
  "id": "herdr",
  "version": "1.0.0",
  "name": "herdr",
  "description": "Installs the herdr CLI from GitHub releases, verified against the sha256 shipped in the feature's checksums.txt.",
  "documentationURL": "https://github.com/Jubast/devcontainer-features/tree/main/src/herdr",
  "licenseURL": "https://github.com/Jubast/devcontainer-features/blob/main/LICENSE",
  "keywords": [
    "herdr",
    "terminal",
    "agents",
    "multiplexer"
  ],
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "proposals": [
        "latest"
      ],
      "description": "Version to install (e.g. 0.9.5), or 'latest'."
    }
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils"
  ]
}
